{
	"name": "@ka-libs/crypto",
	"version": "1.5.2",
	"description": "Cross-environment crypto utility for Node.js & Browser, implement RSA-AES hybrid encryption based on native Web Crypto / Node.js crypto without third-party dependencies.",
	"scripts": {
		"uuid": "node ./cmd/uuid.js",
		"keyPairs": "node ./cmd/create-key-pairs.js"
	},
	"main": "./dist/cjs/index.cjs",
	"module": "./dist/esm/index.js",
	"browser": "dist/index.esm.js",
	"types": "./dist/types/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.cjs"
		},
		"./key-pairs": {
			"import": "./dist/esm/core/keyPairs.js",
			"types": "./dist/types/keyPairs.d.ts"
		},
		"./get-random-bytes": {
			"import": "./dist/esm/lib/getRandomBytes.js",
			"types": "./dist/types/getRandomBytes.d.ts"
		},
		"./array-buffer-to-base64": {
			"import": "./dist/esm/lib/arrayBufferToBase64.js",
			"types": "./dist/types/arrayBufferToBase64.d.ts"
		},
		"./base64-to-array-buffer": {
			"import": "./dist/esm/lib/base64ToArrayBuffer.js",
			"types": "./dist/types/base64ToArrayBuffer.d.ts"
		},
		"./md5": {
			"import": "./dist/esm/hash/md5.js",
			"types": "./dist/types/md5.d.ts"
		},
		"./sha1": {
			"import": "./dist/esm/hash/sha.js",
			"types": "./dist/types/sha.d.ts"
		},
		"./sha256": {
			"import": "./dist/esm/hash/sha.js",
			"types": "./dist/types/sha.d.ts"
		},
		"./sha384": {
			"import": "./dist/esm/hash/sha.js",
			"types": "./dist/types/sha.d.ts"
		},
		"./sha512": {
			"import": "./dist/esm/hash/sha.js",
			"types": "./dist/types/sha.d.ts"
		},
		"./digest": {
			"import": "./dist/esm/hash/digest.js",
			"types": "./dist/types/digest.d.ts"
		},
		"./get-random-values": {
			"import": "./dist/esm/lib/getRandomValues.js",
			"types": "./dist/types/getRandomValues.d.ts"
		},
		"./export-key-pairs": {
			"import": "./dist/esm/lib/exportKeyPairs.js",
			"types": "./dist/types/exportKeyPairs.d.ts"
		},
		"./base64-cleaner": {
			"import": "./dist/esm/lib/base64Cleaner.js",
			"types": "./dist/types/base64Cleaner.d.ts"
		},
		"./uuidv4": {
			"import": "./dist/esm/lib/uuidv4.js",
			"types": "./dist/types/uuidv4.d.ts"
		},
		"./uuidv5": {
			"import": "./dist/esm/lib/uuidv5.js",
			"types": "./dist/types/uuidv5.d.ts"
		},
		"./encrypt": {
			"import": "./dist/esm/crypter/encrypt.js",
			"types": "./dist/types/encrypt.d.ts"
		},
		"./decrypt": {
			"import": "./dist/esm/crypter/decrypt.js",
			"types": "./dist/types/decrypt.d.ts"
		},
		"./rsa-encrypt": {
			"import": "./dist/esm/crypter/rsaEncrypt.js",
			"types": "./dist/types/rsaEncrypt.d.ts"
		},
		"./rsa-decrypt": {
			"import": "./dist/esm/crypter/rsaDecrypt.js",
			"types": "./dist/types/rsaDecrypt.d.ts"
		},
		"./aes-encrypt": {
			"import": "./dist/esm/crypter/aesEncrypt.js",
			"types": "./dist/types/aesEncrypt.d.ts"
		},
		"./aes-decrypt": {
			"import": "./dist/esm/crypter/aesDecrypt.js",
			"types": "./dist/types/aesDecrypt.d.ts"
		}
	},
	"files": [
		"cmd",
		"dist",
		"README.md",
		"THIRDPARTY.md",
		"LICENSE"
	],
	"sideEffects": false,
	"author": "Kuzuki Azusa",
	"license": "MIT",
	"keywords": [
		"crypto",
		"rsa",
		"aes",
		"hybrid-encrypt",
		"web-crypto",
		"node-crypto",
		"cross-browser",
		"cross-node",
		"aes-gcm",
		"rsa-oaep",
		"encrypt",
		"decrypt"
	],
	"devDependencies": {
		"@types/node": "^26.0.1",
		"typescript": "^5.8.3"
	},
	"publishConfig": {
		"access": "public"
	}
}